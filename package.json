    "lint": "tsc --noEmit",
    "test:accounting": "tsx scripts/run-accounting-tests.ts",
    "test:security": "tsx scripts/run-security-and-rls-tests.ts",
    "test:supabase:local": "tsx scripts/run-supabase-local-docker-test.ts",
    "db:migrate": "tsx scripts/apply-supabase-migration.ts",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@google/genai": "^0.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@zxing/library": "^0.23.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.3",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "openai": "^7.23.0",
    "react": "^19.0.0",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-multi-date-picker": "^4.5.2",
